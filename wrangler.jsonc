{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cf-music",
	"compatibility_date": "2026-09-14",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"MINIO_ENDPOINT": "https://s3api.022025.xyz",
		"MINIO_BUCKET": "cf-music",
		"GITHUB_REPO_OWNER": "kurashizu",
		"GITHUB_REPO_NAME": "cf-music",
		"GITHUB_IMPORT_WORKFLOW_FILE": "import.yml",
		// Self-hosted libSQL server (sqld) rather than D1 -- see
		// docs/self-hosted-database.md. Unset this and add a `DB` binding
		// back to run on D1 instead; nothing else changes.
		"LIBSQL_URL": "https://db-au.022025.xyz"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION_KV",
			"id": "757683a8bedf4c53bd20854f6e0f27bb",
			"preview_id": "d299a8b14f4a4fc0993a319e091111e9"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "IMPORT_PROGRESS",
				"class_name": "ImportProgressDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ImportProgressDurableObject"]
		}
	]
}
