{
	"name": "cf-music",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/patch-worker-entry.mjs && wrangler types",
		"preview": "npm run build && wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply cf-music --local",
		"db:migrate:remote": "wrangler d1 migrations apply cf-music --remote",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run --config vitest.config.workers.ts",
		"test:mutation": "stryker run",
		"test:crap": "crap-typescript src/lib/server/auth src/lib/server/eviction src/lib/server/http src/lib/shared",
		"test:all": "npm run test && npm run test:integration && npm run test:crap && npm run test:mutation"
	},
	"devDependencies": {
		"@barney-media/crap-typescript": "^0.5.2",
		"@barney-media/crap-typescript-vitest": "^0.5.2",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.45.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.13.4",
		"@vitest/coverage-v8": "^4.1.11",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"esbuild": true,
		"workerd": true
	},
	"dependencies": {
		"aws4fetch": "^1.0.20"
	}
}
